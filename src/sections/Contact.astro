---
/**
 * Contacto. Sección de este sitio: la cabecera es la del kit, y la tarjeta,
 * marcado propio con `Text` y `ContactLinks` (que se ocupa de `mailto:` y del
 * `tel:` internacional).
 *
 * Los datos salen de `content/profile.json` («Praxisdaten»), los mismos que el
 * kit convierte en JSON-LD: así lo que ve el buscador y lo que ve la persona no
 * pueden contradecirse.
 *
 * Debajo, el formulario del kit. Solo aparece si el admin lo activó en Sumaq
 * (el build recibe entonces `PUBLIC_FORMS_ORIGIN`); sin eso `ContactForm` no
 * emite nada y la sección se queda en las tarjetas.
 */
import {
	Section,
	SectionHeader,
	Text,
	Heading,
	ContactLinks,
	ContactForm,
	cmsKey,
	hasText,
} from "@sumaq/site-kit";
import { loadProfile } from "@sumaq/site-kit/structured-data";
import type { BlockProps } from "@sumaq/site-kit/types";

interface Props extends BlockProps {
	form?: Record<string, string> | null;
}

const {
	sectionLabel,
	sectionTitle,
	sectionTitleAccent,
	sectionSubtitle,
	form,
	section = "contact",
	layout,
	density,
	variant = "muted",
	id = "contact",
} = Astro.props;

const cms = section;
const profile = loadProfile(Astro.currentLocale);
---

<Section layout={layout} density={density} name="contact" variant={variant} id={id} cms={cms}>
	<SectionHeader
		label={sectionLabel}
		title={sectionTitle}
		titleAccent={sectionTitleAccent}
		lede={sectionSubtitle}
		cms={cms}
	/>
	{
		profile && (
			<div class="sq-contact__grid sq-contact__grid--single">
				<article class="sq-contact__card">
					<Heading as="h3" title={profile.name} />
					{hasText(profile.jobTitle) && <Text class="sq-contact__role" text={profile.jobTitle} />}
					<ContactLinks as="none" email={profile.email} phone={profile.telephone} />
				</article>
			</div>
		)
	}
	<ContactForm form={form} cms={cmsKey(cms, "form")} />
</Section>
