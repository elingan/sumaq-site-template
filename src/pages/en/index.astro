---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '@/layouts/Base.astro';
import heroImage from '@/assets/hero.jpg';
import '@/styles/demo.css';

const deHome = getRelativeLocaleUrl('de', '');
---

<Base title="Sumaq — Template" lang="en">
	<main class="demo">
		<p class="demo__eyebrow">
			<Icon name="spark" class="icon" />
			sumaq-astro-base
		</p>
		<h1 class="demo__title">Sumaq</h1>
		<p class="demo__lead sq-align-left">
			Static Astro template with plain CSS, CMS utilities (<span class="sq-strong">sq-*</span>),
			MDX, icons, i18n, sitemap, and Vite dev plugins.
		</p>

		<nav class="demo__nav">
			<a href={deHome}>Deutsch</a>
			<a href="/demo/">MDX Demo</a>
		</nav>

		<div class="demo__media">
			<Image
				src={heroImage}
				alt="Sumaq welcome image"
				width={800}
				height={450}
			/>
		</div>
	</main>
</Base>
