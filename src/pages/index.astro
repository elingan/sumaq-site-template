---
/**
 * Home de arranque. Las secciones son de este sitio (`src/sections/`); el kit
 * aporta los átomos con los que están hechas. Cada una recibe su rama de
 * `content/index.json`, cuyo contrato está en `schema/page.index.yaml`.
 *
 * Para construir el sitio real: cambia la composición aquí, el marcado y las
 * clases en `src/sections/`, el contenido en `content/`, el schema en `schema/`
 * y el diseño en `src/styles/site.css`.
 */
import Base from '../layouts/Base.astro';
import Hero from '../sections/Hero.astro';
import Services from '../sections/Services.astro';
import Contact from '../sections/Contact.astro';
import data from '../../content/index.json';
---

<Base seo={data.seo}>
	<Hero {...data.hero} />
	<Services {...data.services} />
	<Contact {...data.contact} />
</Base>
