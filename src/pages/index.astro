---
/**
 * Home de arranque. Cada bloque viene del kit y recibe su rama de
 * `content/index.json`, cuyo contrato está en `cms/page.index.yaml`.
 *
 * Para construir el sitio real: cambia la composición de bloques aquí, el
 * contenido en `content/`, el schema en `cms/` y el diseño en
 * `src/styles/site.css`. El markup no se toca — vive en el kit.
 */
import Base from '../layouts/Base.astro';
import { Hero, Services, Contact } from '@sumaq/site-kit';
import data from '../../content/index.json';
---

<Base seo={data.seo}>
	<Hero {...data.hero} />
	<Services {...data.services} />
	<Contact {...data.contact} />
</Base>
