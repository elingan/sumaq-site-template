<section class="click-counter">
	<p class="click-counter__label">
		Clicks registrados: <strong id="click-count">—</strong>
	</p>
	<button type="button" id="click-btn" class="click-counter__btn">Registrar click</button>
	<p id="click-error" class="click-counter__error" hidden></p>
</section>

<script>
	const countEl = document.getElementById('click-count');
	const btn = document.getElementById('click-btn');
	const errorEl = document.getElementById('click-error');

	async function loadCount() {
		const response = await fetch('/api/clicks');
		if (!response.ok) {
			throw new Error('load failed');
		}
		const data = (await response.json()) as { clicks: number };
		if (countEl) {
			countEl.textContent = String(data.clicks);
		}
	}

	btn?.addEventListener('click', async () => {
		if (!(btn instanceof HTMLButtonElement)) {
			return;
		}

		btn.disabled = true;
		if (errorEl) {
			errorEl.hidden = true;
			errorEl.textContent = '';
		}

		try {
			const response = await fetch('/api/clicks', { method: 'POST' });
			if (!response.ok) {
				throw new Error('post failed');
			}
			const data = (await response.json()) as { clicks: number };
			if (countEl) {
				countEl.textContent = String(data.clicks);
			}
		} catch {
			if (errorEl) {
				errorEl.textContent = 'No se pudo registrar el click.';
				errorEl.hidden = false;
			}
		} finally {
			btn.disabled = false;
		}
	});

	loadCount().catch(() => {
		if (errorEl) {
			errorEl.textContent = 'No se pudo cargar el contador.';
			errorEl.hidden = false;
		}
	});
</script>

<style>
	.click-counter {
		margin-top: 2rem;
		padding: 1.25rem;
		border: 1px solid #e5e7eb;
		border-radius: 0.5rem;
		max-width: 20rem;
	}

	.click-counter__label {
		margin: 0 0 1rem;
		font-family: var(--font-inter);
	}

	.click-counter__btn {
		font-family: var(--font-inter);
		padding: 0.5rem 1rem;
		border: none;
		border-radius: 0.375rem;
		background: #111827;
		color: #fff;
		cursor: pointer;
	}

	.click-counter__btn:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}

	.click-counter__error {
		margin: 0.75rem 0 0;
		color: #b91c1c;
		font-family: var(--font-inter);
		font-size: 0.875rem;
	}
</style>
