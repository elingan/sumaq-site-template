---
/**
 * Base del sitio: envuelve el layout del kit y le da lo que es propio de este
 * repo — el CSS y los valores por defecto de cabecera y pie.
 *
 * La cascada: `content/index.json` define header y footer una sola vez; cada
 * página puede sobrescribirlos pasando sus propios `header` / `footer`.
 */
import { Base as KitBase } from '@sumaq/site-kit';
import '../styles/global.css';
import defaults from '../../content/index.json';

interface Props {
	seo?: Record<string, any>;
	header?: Record<string, any>;
	footer?: Record<string, any>;
}

const { seo = {}, header: headerOverride, footer: footerOverride } = Astro.props;
const header = { ...defaults.header, ...headerOverride };
const footer = { ...defaults.footer, ...footerOverride };
const chrome: any = { seo, header, footer, logo: header.logo };
---

<KitBase {...chrome}>
	<slot />
</KitBase>
