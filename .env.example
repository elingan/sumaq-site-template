# Build time: sitemap, robots.txt, meta tags (Astro)
SITE_URL=https://tu-dominio.com

# --- Analítica (Ñahui) ---------------------------------------------------
# La `public_key` que Ñahui asigna a este sitio; viaja en `data-site`. La da el
# panel al dar de alta el sitio. Sin ella NO se emite la etiqueta del tracker:
# la analítica es opt-in por sitio. En CI llega como la variable de Actions de
# repo SITE_ANALYTICS_KEY.
# PUBLIC_NAHUI_SITE=

# Origen desde el que se sirve el tracker. Por defecto el de producción; se
# apunta a una Ñahui local para probar sin ensuciar las métricas reales. En CI
# llega como la variable de Actions de organización SITE_ANALYTICS_ORIGIN.
# PUBLIC_NAHUI_ORIGIN=http://localhost:5188
